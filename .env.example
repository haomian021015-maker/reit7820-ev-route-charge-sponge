# Copy this file to `.env` and fill in your own keys. Never commit `.env`.
#
#   cp .env.example .env
#
# Both keys are required: without a working ANTHROPIC_API_KEY the agent refuses
# to start, and without WANDB_API_KEY the evaluation does not run.

# Your individual Claude API key, issued by the course.
ANTHROPIC_API_KEY=

# Weights & Biases, for `run_eval.py --wandb`.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=reit7820-charging

# Optional: pick a model tier. Defaults to claude-haiku-4-5.
LLM_MODEL=
