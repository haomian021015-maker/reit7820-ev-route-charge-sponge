# Copy this file to `.env` and fill in your own keys. Never commit `.env`.
#
#   cp .env.example .env
#
# Both keys are required: without a working ANTHROPIC_API_KEY the agent refuses
# to start, and without WANDB_API_KEY the evaluation does not run.

# Your individual Claude API key, issued by the course.
ANTHROPIC_API_KEY=

# Weights & Biases. Every evaluation run is logged here, so this is required too.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=reit7820-charging

# Open Charge Map. Only needed to refresh the pinned station snapshot with
#   python src/data.py refresh-ocm
# The agent reads the committed snapshot and runs without it. Get a key by
# registering an application at https://openchargemap.org/profile/applications
OCM_API_KEY=

# Your zone's access token. Only needed to run the handshake test against the
# deployed agent from this laptop. Read it on the zone with
#   cat /opt/mcp-agent/TOKEN.txt
# and give the same value to your tutor through the zone setup form.
MCP_TOKEN=

# Optional: pick a model tier. Defaults to claude-haiku-4-5.
LLM_MODEL=
